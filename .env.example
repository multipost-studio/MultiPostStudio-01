# ─────────────────────────────────────────────────────────────────────────────
# MultiPost Studio environment. Copy to `.env` and fill in.
#
# Only the CORE block is required. Every integration block is optional — leave
# it unset and that adapter runs in stub mode (see src/lib/env.ts `flags`).
# ─────────────────────────────────────────────────────────────────────────────

# ── Core (required) ────────────────────────────────────────────────────────
# Postgres, everywhere (local dev included).
#
# Supabase: DATABASE_URL = the *pooled* (Supavisor) string, port 6543, with
#   ?pgbouncer=true&connection_limit=1 appended. DIRECT_URL = the *direct*
#   string, port 5432 (host db.<ref>.supabase.co). prisma migrate uses
#   DIRECT_URL; the app runtime uses DATABASE_URL.
# Percent-encode special characters in the password.
DATABASE_URL="postgresql://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres:<pw>@db.<ref>.supabase.co:5432/postgres"

# Session/JWT signing secret — generate with: openssl rand -base64 32
AUTH_SECRET="change-me-min-16-chars"

# Public origin, no trailing slash. Used for email links + Stripe redirects.
APP_URL="http://localhost:3000"

# ── Google OAuth (optional) ────────────────────────────────────────────────
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ── AI / LLM (optional → real AI when ANTHROPIC_API_KEY is set) ─────────────
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"

# ── Billing ──────────────────────────────────────────────────────────────
# Configure ONE provider. Razorpay wins if both are set. Neither set → the
# internal confirm page applies plan changes directly (demo mode).

# Razorpay (Subscriptions API).
# Webhook endpoint to register (Razorpay Dashboard → Settings → Webhooks):
#   {APP_URL}/api/webhooks/razorpay
# Active events: subscription.activated, subscription.charged,
#   subscription.resumed, subscription.cancelled, subscription.completed,
#   subscription.halted
# Also set the post-payment redirect URL in the Razorpay dashboard to
#   {APP_URL}/settings/billing?changed=1
# NOTE: PLAN_CATALOG prices in src/lib/constants.ts are the minor unit of
# RAZORPAY_CURRENCY (paise). The defaults are USD-cent values — set real INR
# amounts (e.g. pro = 149900 for ₹1499) before charging anyone.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
RAZORPAY_CURRENCY="INR"

# Stripe (alternative). Webhook: {APP_URL}/api/webhooks/stripe
# Events: checkout.session.completed, customer.subscription.updated,
#         customer.subscription.deleted
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ── Transactional email (optional → real mail when RESEND_API_KEY is set) ──
RESEND_API_KEY=""
EMAIL_FROM="MultiPost Studio <no-reply@multipoststudio.example>"

# ── Object storage (optional → S3/R2/Spaces when S3_BUCKET + keys are set) ─
S3_BUCKET=""
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""          # CDN / public bucket base URL (optional)

# ── Distributed rate limiting (optional → Upstash Redis when both set) ─────
# Without these, rate limiting is in-memory (per-instance only).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ── Social OAuth (optional → real connect + publish per platform) ─────────
# Callback base (defaults to APP_URL). Register this exact callback with each
# provider:  {BASE}/api/oauth/<platform>/callback
OAUTH_REDIRECT_BASE=""
# AES-256 key for encrypting stored tokens — base64 of 32 bytes.
# Generate: openssl rand -base64 32   (falls back to a key derived from
# AUTH_SECRET if unset; set an explicit one in production)
TOKEN_ENC_KEY=""
# LinkedIn — needs the "Share on LinkedIn" + "Sign In with LinkedIn" products
OAUTH_LINKEDIN_CLIENT_ID=""
OAUTH_LINKEDIN_CLIENT_SECRET=""
# Meta app — covers facebook + instagram. Needs the "Manage everything on your
# Page" + "Manage messaging & content on Instagram" use cases, pages_manage_posts
# / instagram_content_publish, and an IG Business account linked to a FB Page.
# Redirect URIs: {BASE}/api/oauth/facebook/callback and .../instagram/callback
OAUTH_META_CLIENT_ID=""
OAUTH_META_CLIENT_SECRET=""
# Threads — separate app ID/secret from the "Access the Threads API" use case
# (falls back to OAUTH_META_* if unset). Redirect: {BASE}/api/oauth/threads/callback
# Also set the use case's Uninstall + Delete callbacks to
# {BASE}/api/threads/deauthorize and {BASE}/api/threads/delete
OAUTH_THREADS_CLIENT_ID=""
OAUTH_THREADS_CLIENT_SECRET=""
# X / Twitter — OAuth2 with PKCE, "Read and write" app permissions
OAUTH_X_CLIENT_ID=""
OAUTH_X_CLIENT_SECRET=""
# Google — covers youtube (+ gbp). Enable the "YouTube Data API v3" and
# "YouTube Analytics API" in the Google Cloud project. OAuth consent screen
# scopes: youtube.upload, youtube.readonly, youtube.force-ssl,
# yt-analytics.readonly. Redirect: {BASE}/api/oauth/youtube/callback
# This is a SEPARATE OAuth client from AUTH_GOOGLE_* (used for user login).
OAUTH_GOOGLE_CLIENT_ID=""
OAUTH_GOOGLE_CLIENT_SECRET=""
# TikTok
OAUTH_TIKTOK_CLIENT_KEY=""
OAUTH_TIKTOK_CLIENT_SECRET=""
# Pinterest
OAUTH_PINTEREST_CLIENT_ID=""
OAUTH_PINTEREST_CLIENT_SECRET=""
# Bluesky needs no config — users connect with an app password.

# ── Stock photos (optional) ─────────────────────────────────────────────
# Unsplash "Access Key" from a registered app at https://unsplash.com/oauth/applications
# — one app-level key, no per-user OAuth. Enables the Unsplash tab in the
# composer + media library. Free tier: 50 req/hr (demo) or 5000/hr (approved).
UNSPLASH_ACCESS_KEY=""

# ── Ops ────────────────────────────────────────────────────────────────────
# When set, /api/cron/tick requires `Authorization: Bearer <CRON_SECRET>` and
# the in-app client poller disables itself. Generate: openssl rand -hex 24
CRON_SECRET=""
LOG_LEVEL="info"          # fatal|error|warn|info|debug|trace
WORKER_INTERVAL_MS="15000"

# Set to "1" to keep demo-login hints visible in a production build.
NEXT_PUBLIC_SHOW_DEMO=""
