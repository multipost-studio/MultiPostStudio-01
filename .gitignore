# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# local databases / indexes / caches (never deploy these)
*.db
*.db-journal
prisma/dev.db
ruvector.db
.impeccable/

# locally-uploaded media (storage adapter's local fallback)
/public/uploads/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# secrets / keys / credentials — NEVER commit
*.key
*.p8
*.p12
*.pfx
*.pkcs12
*.keystore
*.jks
*.asc
*.gpg
*_rsa
*_rsa.pub
id_ed25519*
*-service-account*.json
*serviceaccount*.json
*service_account*.json
gcloud-*.json
*credentials*.json
*credential*.json
*secret*.json
secrets/
.secrets/
auth.json
.npmrc
.dockercfg
.docker/config.json
*.tfvars
*.tfstate
*.tfstate.*
.terraform/

# agent / editor local state (may contain tokens, transcripts, history)
.claude/*
!.claude/launch.json
.serena/
.mcp.json
.cursor/
.aider*
.vscode/*
!.vscode/extensions.json

# playwright
/playwright-report/
/test-results/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
